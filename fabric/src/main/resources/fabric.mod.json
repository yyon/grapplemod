{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/grappling-hook-mod",
        "sources": "https://github.com/yyon/grapplemod",
        "issues": "https://github.com/yyon/grapplemod/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.yyon.grapplemod.GrappleModFabric"
        ],
        "client": [
            "com.yyon.grapplemod.GrappleModFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "forgeconfigapiport": ">=21.1.6",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
